includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Temporary until Task 4's first model uses the trait; Task 4 removes this entry.
        -
            identifier: trait.unused
            path: app/Models/Concerns/ImmutableWhenIssued.php
